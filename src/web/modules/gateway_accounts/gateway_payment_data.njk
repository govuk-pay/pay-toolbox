{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% extends "layout/layout.njk" %}

{% set isTestData = account and not (account.type === "live") %}

{% set payment_provider_but_stripe_is_adyen %}
  {{ 'adyen' if account.payment_provider === 'stripe' else account.payment_provider }}
{% endset %}

{% block main %}
  <h1 class="govuk-heading-m">Manage payment details sent to {{ payment_provider_but_stripe_is_adyen | capitalize }}</h1>

  <div>
    <a href="/gateway_accounts/{{ account.gateway_account_id }}" class="govuk-back-link">Gateway account ({{ account.gateway_account_id }})</a>
  </div>

  <p class="govuk-body">We can customise the payment details that we send to {{ payment_provider_but_stripe_is_adyen | capitalize }} in payment authorisation requests.</p>

  {% if account.payment_provider === 'stripe' %}
    <p class="govuk-body">This will not affect the data sent to Stripe now, only the data sent to Adyen after migration.</p>
  {% endif %}

  <form method="POST" action="/gateway_accounts/{{ account.gateway_account_id }}/gateway_payment_data">

    {% if account.payment_provider === 'worldpay' %}
      {{ govukRadios({
        classes: "govuk-radios--inline",
        name: "description",
        fieldset: {
          legend: {
            text: "What should we sent to Worldpay in the description field?",
            isPageHeading: true,
            classes: "govuk-fieldset__legend--s"
          }
        },
        hint: {
          text: "We can send either the payment reference or payment description"
        },
        items: [
          {
            value: "description",
            text: "Description",
            checked: not account.send_reference_to_gateway
          },
          {
            value: "reference",
            text: "Reference",
            checked: account.send_reference_to_gateway
          }
        ]
      }) }}
    {% endif %}

    {{ govukRadios({
      classes: "govuk-radios--inline",
      name: "email",
      fieldset: {
        legend: {
          text: "Should we send the payer’s email address?",
          isPageHeading: true,
          classes: "govuk-fieldset__legend--s"
        }
      },
      items: [
        {
          value: "yes",
          text: "Yes",
          checked: account.send_payer_email_to_gateway
        },
        {
          value: "no",
          text: "No",
          checked: not account.send_payer_email_to_gateway
        }
      ]
    }) }}

    {{ govukRadios({
      classes: "govuk-radios--inline",
      name: "ip",
      fieldset: {
        legend: {
          text: "Should we send the payer’s IP address?",
          isPageHeading: true,
          classes: "govuk-fieldset__legend--s"
        }
      },
      items: [
        {
          value: "yes",
          text: "Yes",
          checked: account.send_payer_ip_address_to_gateway
        },
        {
          value: "no",
          text: "No",
          checked: not account.send_payer_ip_address_to_gateway
        }
      ]
    }) }}

    {{ govukButton({
      text: "Save"
    })
    }}

    <input type="hidden" name="_csrf" value="{{ csrf }}">
  </form>
{% endblock %}
